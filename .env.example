# Copy this file to .env on the target machine before running Docker Compose.
SPURLINE_DATA_DIR=/mnt/bitcoin/spurline

# Loopback is appropriate when the reverse proxy runs on this host. Select a
# private LAN or VPN interface explicitly when the proxy runs elsewhere.
SPURLINE_BIND_ADDRESS=127.0.0.1
SPURLINE_PORT=8780

# Set this to the wss:// URL exposed by the reverse proxy.
# SPURLINE_PUBLIC_URL=wss://relay.example.com

# Keep signature verification enabled outside disposable test fixtures.
SPURLINE_VERIFY_SIGNATURES=true

# Optional stable service identity. Generate once with `openssl rand -hex 32`
# and preserve it with the relay data directory.
SPURLINE_SERVICE_NSEC=
SPURLINE_SERVICE_MANAGEMENT=independent

# Experimental automatic receipts: requires commissioning, witness authorization,
# and a trusted clock monitor. See docs/automatic-witness-operation.md.
SPURLINE_WITNESS_ENABLED=false
# Container-visible path; mount the monitor directory read-only in an override.
SPURLINE_WITNESS_CLOCK_FILE=
# Use operational with the bundled timesyncd monitor and approved operational policy.
SPURLINE_WITNESS_CLOCK_MODE=bounded
SPURLINE_WITNESS_QUEUE_LIMIT=1000
SPURLINE_WITNESS_MAX_DELAY_SECONDS=60
